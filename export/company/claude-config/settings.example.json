{
  "_comment": "配置先の .claude/settings.json に手動マージする雛形（丸ごと上書きしない）。既存 allow と衝突したら deny を優先。マスターとの差分: npx を ask から deny に強化（npx 全面禁止の方針）・validate-skill-edit.sh（マスター専用）と stop-typecheck.sh（Angular ではテンプレートを型チェックできず CI と重複）と remind-config-docs.sh（マスターの docs/ 構成前提）を hooks から除外。登録している hook は 6 本。うち 5 本（session-start-check / session-stop / guard-env-read / guard-gated-write / post-edit-lint）は POSIX 標準ユーティリティのみで動き追加インストール不要。guard-gated-delete.sh のみ python3（標準ライブラリのみ・jq 等の追加パッケージは不要）に依存し、python3 が無い環境や JSON 抽出失敗時は沈黙して素通りする（フェイルオープン。ゲートが無効でも通知は出ないので、配置後に python3 の存在を必ず確認する）。PreToolUse(Bash) の 3 本は 1 つの matcher にまとめる（matcher を分けると後段の hook が実行されない）。guard-gated-write.sh は ask（Edit 規則が Edit/Write 双方を覆う）が Bash のリダイレクトで迂回されるのを塞ぎ、guard-gated-delete.sh は rm / mv による迂回を塞ぐ。いずれも permissions.ask の CLAUDE.md / docs/knowledge/ / docs/decisions/ と対で維持する",
  "permissions": {
    "allow": [
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(rm -r*)",
      "Edit(./.claude/settings.json)",
      "Write(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Write(./.claude/settings.local.json)",
      "Edit(./.claude/hooks/**)",
      "Write(./.claude/hooks/**)",
      "Edit(./CLAUDE.md)",
      "Write(./CLAUDE.md)",
      "Edit(./docs/knowledge/*)",
      "Write(./docs/knowledge/*)",
      "Edit(./docs/knowledge/**)",
      "Write(./docs/knowledge/**)",
      "Edit(./docs/knowledge/**/*)",
      "Write(./docs/knowledge/**/*)",
      "Edit(./docs/decisions/*)",
      "Write(./docs/decisions/*)",
      "Edit(./docs/decisions/**)",
      "Write(./docs/decisions/**)",
      "Edit(./docs/decisions/**/*)",
      "Write(./docs/decisions/**/*)"
    ],
    "deny": [
      "Bash(npx)",
      "Bash(npx *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm install)",
      "Bash(pnpm install *)",
      "Bash(pnpm i)",
      "Bash(pnpm i *)",
      "Bash(pnpm dlx *)",
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm i)",
      "Bash(npm i *)",
      "Bash(npm ci)",
      "Bash(npm ci *)",
      "Bash(npm exec *)",
      "Bash(yarn add *)",
      "Bash(yarn install)",
      "Bash(yarn install *)",
      "Bash(yarn dlx *)",
      "Bash(bun add *)",
      "Bash(bun install)",
      "Bash(bun install *)",
      "Bash(bunx *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(brew install *)",
      "Bash(cat .env*)",
      "Bash(cat *.env)",
      "Bash(grep * .env*)",
      "Bash(grep * *.env)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(env)",
      "Read(./.env*)",
      "Read(./**/.env*)",
      "Read(./*.env)",
      "Read(./**/*.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.claude/.credentials.json)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * +*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start-check.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-gated-delete.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-env-read.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-gated-write.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-lint.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-stop.sh"
          }
        ]
      }
    ]
  }
}
